{
  "name": "@primajin/gyros",
  "version": "1.2.5",
  "description": "A JavaScript library for creating shiny effects on HTML elements using gyroscope or mouse movement.",
  "license": "ISC",
  "repository": "github:Primajin/Gyros",
  "homepage": "https://github.com/Primajin/Gyros#readme",
  "bugs": "https://github.com/Primajin/Gyros/issues",
  "author": "Jannis Hell",
  "type": "module",
  "exports": {
    "import": "./dist/gyros.es.js",
    "require": "./dist/gyros.umd.cjs",
    "default": "./dist/gyros.es.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.js",
    "build:preview": "vite build",
    "coverage": "vitest run --coverage",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "lint:watch": "nodemon -x npm run lint:fix --ext js,jsx,json",
    "start": "vite",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "shiny",
    "effect",
    "gradient",
    "gyroscope",
    "interactive"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.22",
    "eslint": "^10.11.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.14",
    "vite": "^8.1.4",
    "vitest": "^5.0.0",
    "xo": "^5.0.1"
  }
}
