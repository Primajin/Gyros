{
  "name": "gyros",
  "version": "1.0.0",
  "description": "A JavaScript library for creating shiny effects on HTML elements using gyroscope or mouse movement.",
  "main": "dist/gyros.umd.js",
  "module": "dist/gyros.es.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.lib.js",
    "build:preview": "vite build",
    "coverage": "vitest run --coverage",
    "lint": "xo --config eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,jsx,json",
    "start": "vite",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Primajin/Gyros.git"
  },
  "keywords": [
    "shiny",
    "effect",
    "gradient",
    "gyroscope",
    "interactive"
  ],
  "author": {
    "name": "Jannis Hell"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Primajin/Gyros/issues"
  },
  "homepage": "https://github.com/Primajin/Gyros#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "xo": "^2.0.2"
  }
}
