    "gradient",
    "gyroscope",
    "interactive"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Primajin/Gyros/issues"
  },
  "homepage": "https://github.com/Primajin/Gyros#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
