{
  "name": "gyros",
  "version": "1.0.0",
  "description": "A JavaScript library for creating shiny effects on HTML elements using gyroscope or mouse movement.",
  "main": "dist/gyros.umd.js",
  "module": "dist/gyros.es.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build --config vite.config.lib.js",
